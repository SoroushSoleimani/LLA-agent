# Copy this file to .env and fill it in. Never share or commit .env.

ARVAN_API_KEY=your-arvan-api-key
ARVAN_BASE_URL=https://api.arvancloudai.ir/v1
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
ALLOWED_TELEGRAM_USER_ID=123456789

# Password for the web interface. Use a long one.
WEB_PASSWORD=change-me-to-a-long-password

# Your timezone, e.g. Europe/London, Asia/Tehran, America/New_York
TIMEZONE=UTC
# When LLa sends your daily plan (HH:MM, in your timezone)
MORNING_PLAN_TIME=07:30
